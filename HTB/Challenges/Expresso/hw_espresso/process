open('app_tmp.bin','wb').write(app_raw)
img = LoadFirmwareImage('esp32', 'app_tmp.bin')# Real size = last segment + its header, aligned to 16, plus 32 bytes of hash
last = img.segments[-1]
img_size = (last.file_offs + 8 + len(last.data) + 15) & ~15
img_size += 32
print(f'Real app size: 0x{img_size:x} ({img_size} bytes)'); open('app.bin','wb').write(app_raw[:img_size])
"
